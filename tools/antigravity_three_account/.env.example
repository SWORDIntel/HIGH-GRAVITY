# Optional Antigravity three-account wrapper overrides.
# Source with: set -a; source tools/antigravity_three_account/.env.example; set +a

export ANTIGRAVITY_CMD="agy"
export AGY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/high-gravity/antigravity/accounts.json"
export AGY_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/high-gravity/antigravity"
export AGY_VENV="$PWD/tools/antigravity_three_account/.venv"
# export AGY_ACCOUNT="account_1"

# Bounded asynchronous decrypted-flow writer
export HG_DECRYPTED_TRAFFIC_LOG_MAX_BYTES=104857600
export HG_DECRYPTED_TRAFFIC_LOG_BACKUP_COUNT=5
export HG_DECRYPTED_TRAFFIC_QUEUE_SIZE=256
export AGY_CONFIG="$HOME/.config/high-gravity/antigravity/accounts.json"
export AGY_STATE_DIR="$HOME/.local/state/high-gravity/antigravity"
export AGY_VENV="$PWD/tools/antigravity_three_account/.venv"
# export AGY_ACCOUNT="account_1"
